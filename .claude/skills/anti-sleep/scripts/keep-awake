#!/usr/bin/env bash
# Hold a session-long macOS idle-sleep assertion for agent work.
# Usage: keep-awake start [seconds] | status | stop | renew [seconds]
set -euo pipefail

DEFAULT_TIMEOUT=28800
umask 077
STATE_DIR="${HOME}/Library/Caches/loadout-anti-sleep"
PIDFILE="${STATE_DIR}/keep-awake.pid"
LOCKDIR="${PIDFILE}.lock"

usage() {
  echo "usage: keep-awake start [seconds] | status | stop | renew [seconds]" >&2
  exit 2
}

is_darwin() {
  [[ "$(uname -s)" == "Darwin" ]]
}

require_timeout() {
  local timeout="$1"
  if [[ ! "$timeout" =~ ^[1-9][0-9]*$ ]]; then
    echo "anti-sleep: timeout must be a positive integer of seconds, got: $timeout" >&2
    exit 2
  fi
}

ensure_state_dir() {
  if [[ -z "${HOME:-}" ]]; then
    echo "anti-sleep: HOME is not set" >&2
    exit 1
  fi
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
}

is_positive_pid() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

pid_ps_args() {
  local pid="$1"
  local args
  args="$(ps -ww -p "$pid" -o args= 2>/dev/null || true)"
  if [[ -z "$args" ]]; then
    args="$(ps -ww -p "$pid" -o command= 2>/dev/null || true)"
  fi
  printf '%s' "$args"
}

# Live PID whose comm or args look like caffeinate, even before ps shows -i.
is_caffeinate_pid() {
  local pid="$1"
  local comm args
  is_positive_pid "$pid" || return 1
  kill -0 -- "$pid" 2>/dev/null || return 1
  comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
  comm="${comm//[$' \t']/}"
  args="$(pid_ps_args "$pid")"
  if [[ "$comm" == "caffeinate" ]]; then
    return 0
  fi
  case "$args" in
    *caffeinate*) return 0 ;;
  esac
  return 1
}

# Obvious stale pidfile target (e.g. test sleep helper), not a launching keeper.
is_sleep_leftover_pid() {
  local pid="$1"
  local args comm
  is_positive_pid "$pid" || return 1
  comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
  comm="${comm//[$' \t']/}"
  case "$comm" in
    sleep) return 0 ;;
  esac
  args="$(pid_ps_args "$pid")"
  case "$args" in
    sleep\ * | *sleep\ * | */sleep\ *) return 0 ;;
  esac
  return 1
}

is_keeper_pid() {
  # Live caffeinate plus " -i " in args so unrelated caffeinate -w/-d is rejected.
  # comm==caffeinate matches macOS; args *caffeinate* is for PATH stubs whose
  # comm is the interpreter (python3 shebang in Linux CI). comm= is space-padded
  # on some ps; args= is empty on some BSD ps, so fall back to command=.
  local pid="$1"
  local padded
  is_caffeinate_pid "$pid" || return 1
  padded=" $(pid_ps_args "$pid") "
  case "$padded" in
    *" -i "*) return 0 ;;
  esac
  return 1
}

running_pid() {
  local pid
  if [[ -L "$PIDFILE" ]]; then
    rm -f "$PIDFILE"
    return 1
  fi
  if [[ ! -f "$PIDFILE" ]]; then
    return 1
  fi
  pid="$(tr -d '[:space:]' <"$PIDFILE")"
  if is_keeper_pid "$pid"; then
    printf '%s\n' "$pid"
    return 0
  fi
  # Live peer (keeper whose -i is not visible yet, or leftover process): do
  # not unlink. Same rule as peer_pidfile_live.
  if is_positive_pid "$pid" && kill -0 -- "$pid" 2>/dev/null; then
    return 1
  fi
  rm -f "$PIDFILE"
  return 1
}

write_pidfile() {
  local pid="$1"
  # Unlink an existing symlink so we never write through it.
  if [[ -L "$PIDFILE" ]]; then
    rm -f "$PIDFILE"
  fi
  # If a symlink is still there, refuse (do not follow it).
  if [[ -L "$PIDFILE" ]]; then
    echo "anti-sleep: pidfile is a symlink; refusing to write" >&2
    return 1
  fi
  # Remove a leftover regular pidfile so noclobber can create a new regular file.
  rm -f "$PIDFILE"
  (
    set -o noclobber
    printf '%s\n' "$pid" >"$PIDFILE"
  )
}

lock_holder_alive() {
  local holder
  [[ -f "$LOCKDIR/pid" ]] || return 1
  holder="$(tr -d '[:space:]' <"$LOCKDIR/pid" 2>/dev/null || true)"
  is_positive_pid "$holder" || return 1
  kill -0 -- "$holder" 2>/dev/null
}

lockdir_age_seconds() {
  local now mtime
  now="$(date +%s)"
  mtime="$(stat -c %Y "$LOCKDIR" 2>/dev/null || stat -f %m "$LOCKDIR" 2>/dev/null || echo "$now")"
  echo $((now - mtime))
}

reclaim_stale_lock() {
  rm -f "$LOCKDIR/pid" 2>/dev/null || true
  rmdir "$LOCKDIR" 2>/dev/null || true
}

acquire_lock() {
  local n=0
  ensure_state_dir
  while ! mkdir "$LOCKDIR" 2>/dev/null; do
    n=$((n + 1))
    if lock_holder_alive; then
      if [[ "$n" -ge 100 ]]; then
        echo "anti-sleep: timed out waiting for lock" >&2
        exit 1
      fi
      sleep 0.05
      continue
    fi
    # Dead holder, empty lockdir older than the 5s wait, or last attempt.
    if [[ -f "$LOCKDIR/pid" ]] || [[ "$(lockdir_age_seconds)" -ge 5 ]] || [[ "$n" -ge 100 ]]; then
      reclaim_stale_lock
    fi
    if [[ "$n" -ge 100 ]]; then
      if mkdir "$LOCKDIR" 2>/dev/null; then
        break
      fi
      echo "anti-sleep: timed out waiting for lock" >&2
      exit 1
    fi
    if [[ -d "$LOCKDIR" ]]; then
      sleep 0.05
    fi
  done
  printf '%s\n' "$$" >"$LOCKDIR/pid"
  trap release_lock EXIT
  trap 'exit 1' INT TERM HUP
}

release_lock() {
  local holder=""
  holder="$(tr -d '[:space:]' <"$LOCKDIR/pid" 2>/dev/null || true)"
  if [[ "$holder" != "$$" ]]; then
    return 0
  fi
  rm -f "$LOCKDIR/pid" 2>/dev/null || true
  rmdir "$LOCKDIR" 2>/dev/null || true
}

finish_lock() {
  release_lock
  trap - EXIT INT TERM HUP
}

launch() {
  local timeout="$1"
  local pid
  require_timeout "$timeout"
  if ! command -v caffeinate >/dev/null; then
    echo "anti-sleep: caffeinate not found on PATH" >&2
    exit 1
  fi
  nohup caffeinate -i -t "$timeout" >/dev/null 2>&1 &
  pid=$!
  if ! write_pidfile "$pid"; then
    kill -- "$pid" 2>/dev/null || true
    return 1
  fi
  disown "$pid" 2>/dev/null || true
  printf '%s\n' "$pid"
}

# Weaker than is_keeper_pid: positive pid + kill -0 only. A just-launched
# keeper may have a pidfile before ps shows -i / caffeinate. Do not require
# those matches here, and do not unlink a still-live pidfile.
peer_pidfile_live() {
  local pid
  [[ -L "$PIDFILE" ]] && return 1
  [[ -f "$PIDFILE" ]] || return 1
  pid="$(tr -d '[:space:]' <"$PIDFILE")"
  is_positive_pid "$pid" && kill -0 -- "$pid" 2>/dev/null
}

peer_is_in_progress_keeper() {
  local pid
  peer_pidfile_live || return 1
  pid="$(tr -d '[:space:]' <"$PIDFILE")"
  is_keeper_pid "$pid" && return 1
  is_caffeinate_pid "$pid"
}

finish_already_running() {
  echo "anti-sleep: already running pid=$1"
  finish_lock
}

# Caller holds the lock. If a keeper is visible, report it; otherwise launch.
report_running_or_launch() {
  local timeout="$1"
  local pid
  pid="$(tr -d '[:space:]' <"$PIDFILE" 2>/dev/null || true)"
  if is_keeper_pid "$pid"; then
    finish_already_running "$pid"
    return 0
  fi
  if ! pid="$(launch "$timeout")"; then
    finish_lock
    return 1
  fi
  echo "anti-sleep: started pid=$pid timeout=${timeout}s (PreventUserIdleSystemSleep)"
  echo "anti-sleep: verify with: pmset -g assertions"
  finish_lock
}

# Brief ps retry: a just-forked keeper may not look like caffeinate yet.
# Same bound as cmd_stop's in-progress path (5 × 0.02s).
peer_pid_shows_caffeinate() {
  local pid="$1"
  local n=0
  while [[ "$n" -lt 5 ]]; do
    if is_keeper_pid "$pid" || is_caffeinate_pid "$pid"; then
      return 0
    fi
    n=$((n + 1))
    sleep 0.02
  done
  return 1
}

cmd_start() {
  local timeout="${1:-$DEFAULT_TIMEOUT}"
  local pid attempt
  # Wait for ps to show -i on a just-launched peer, not lock timeout
  # (acquire_lock is 100 × 0.05s ≈ 5s). 250 × 0.02s ≈ 5s.
  local peer_wait_attempts=250
  local peer_wait_sleep=0.02

  for attempt in $(seq 1 "$peer_wait_attempts"); do
    acquire_lock
    if [[ -L "$PIDFILE" ]]; then
      rm -f "$PIDFILE"
      finish_lock
      continue
    fi
    if peer_is_in_progress_keeper; then
      finish_lock
      sleep "$peer_wait_sleep"
      continue
    fi
    pid="$(tr -d '[:space:]' <"$PIDFILE" 2>/dev/null || true)"
    if is_positive_pid "$pid" && kill -0 -- "$pid" 2>/dev/null; then
      if is_keeper_pid "$pid"; then
        finish_already_running "$pid"
        return 0
      fi
      if is_sleep_leftover_pid "$pid"; then
        : # steal below
      else
        finish_lock
        sleep "$peer_wait_sleep"
        continue
      fi
    fi
    report_running_or_launch "$timeout"
    return $?
  done

  acquire_lock
  if [[ -L "$PIDFILE" ]]; then
    rm -f "$PIDFILE"
  fi
  pid="$(tr -d '[:space:]' <"$PIDFILE" 2>/dev/null || true)"
  if is_keeper_pid "$pid" || peer_is_in_progress_keeper; then
    finish_already_running "$pid"
    return 0
  fi
  if is_positive_pid "$pid" && kill -0 -- "$pid" 2>/dev/null && ! is_sleep_leftover_pid "$pid"; then
    finish_already_running "$pid"
    return 0
  fi
  # After the peer wait the pidfile is stuck (never became a keeper) and may
  # be replaced. Steal-after-wait for dead/empty/sleep leftovers, not live peers.
  rm -f "$PIDFILE"
  report_running_or_launch "$timeout"
}

cmd_status() {
  local pid=""
  acquire_lock
  pid="$(running_pid || true)"
  release_lock
  trap - EXIT INT TERM HUP
  if [[ -n "$pid" ]]; then
    echo "anti-sleep: running pid=$pid"
    if command -v pmset >/dev/null; then
      pmset -g assertions || true
    fi
    return 0
  fi
  echo "anti-sleep: not running" >&2
  exit 1
}

cmd_stop() {
  local pid n
  acquire_lock
  if pid="$(running_pid)"; then
    kill -- "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
    echo "anti-sleep: stopped pid=$pid"
    return 0
  fi
  if [[ -f "$PIDFILE" ]] && [[ ! -L "$PIDFILE" ]]; then
    pid="$(tr -d '[:space:]' <"$PIDFILE")"
    if is_positive_pid "$pid" && kill -0 -- "$pid" 2>/dev/null; then
      n=0
      while [[ "$n" -lt 5 ]]; do
        if is_keeper_pid "$pid" || is_caffeinate_pid "$pid"; then
          kill -- "$pid" 2>/dev/null || true
          rm -f "$PIDFILE"
          echo "anti-sleep: stopped pid=$pid"
          return 0
        fi
        n=$((n + 1))
        sleep 0.02
      done
      # Live non-caffeinate leftover: leave the pidfile for start to replace.
      echo "anti-sleep: not running"
      return 0
    fi
  fi
  rm -f "$PIDFILE"
  echo "anti-sleep: not running"
}

cmd_renew() {
  local timeout="${1:-$DEFAULT_TIMEOUT}"
  local old new
  acquire_lock
  old="$(running_pid || true)"
  if ! new="$(launch "$timeout")"; then
    return 1
  fi
  if [[ -n "$old" && "$old" != "$new" ]] && is_keeper_pid "$old"; then
    kill -- "$old" 2>/dev/null || true
  fi
  echo "anti-sleep: renewed pid=$new timeout=${timeout}s (PreventUserIdleSystemSleep)"
}

[[ $# -ge 1 ]] || usage
command="$1"
shift || true

# Unknown verbs must be rejected before the non-macOS no-op so they still
# exit 2 on Linux instead of printing the Darwin skip and exiting 0.
case "$command" in
  start | status | stop | renew) ;;
  *) usage ;;
esac

if ! is_darwin; then
  echo "anti-sleep: not macOS ($(uname -s)); no-op"
  exit 0
fi

case "$command" in
  start) cmd_start "${1:-}" ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  renew) cmd_renew "${1:-}" ;;
esac
